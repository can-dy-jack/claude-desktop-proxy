{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desktop Proxy",
  "version": "0.1.0",
  "identifier": "com.local.claude-desktop-proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Desktop Proxy",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
