{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desktop Proxy",
  "version": "0.1.4",
  "identifier": "com.local.claude-desktop-proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Claude Desktop Proxy",
        "width": 800,
        "height": 600,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "sidebar"],
          "state": "active",
          "radius": 18
        }
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
